{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "SLAC Theme",
  "description": "SLAC brand colors and base styles.",
  "cssVars": {
    "theme": {
      "color-badge": "var(--badge)",
      "color-badge-foreground": "var(--badge-foreground)"
    },
    "light": {
      "radius": "0.625rem",
      "background": "oklch(1 0 0)",
      "foreground": "oklch(0.145 0 0)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.145 0 0)",
      "popover": "oklch(1 0 0)",
      "popover-foreground": "oklch(0.145 0 0)",
      "primary": "#b1040e",
      "primary-foreground": "oklch(0.985 0 0)",
      "secondary": "oklch(0.97 0 0)",
      "secondary-foreground": "oklch(0.205 0 0)",
      "muted": "oklch(0.97 0 0)",
      "muted-foreground": "oklch(0.556 0 0)",
      "accent": "#dad7cb",
      "accent-foreground": "oklch(0.205 0 0)",
      "destructive": "oklch(0.577 0.245 27.325)",
      "border": "oklch(0.922 0 0)",
      "input": "oklch(0.922 0 0)",
      "ring": "#b1040e",
      "chart-1": "#e98300",
      "chart-2": "#007c92",
      "chart-3": "#175e54",
      "chart-4": "#fedd5c",
      "chart-5": "#e04f39",
      "sidebar": "oklch(0.985 0 0)",
      "sidebar-foreground": "oklch(0.145 0 0)",
      "sidebar-primary": "#b1040e",
      "sidebar-primary-foreground": "oklch(0.985 0 0)",
      "sidebar-accent": "#dad7cb",
      "sidebar-accent-foreground": "oklch(0.205 0 0)",
      "sidebar-border": "oklch(0.922 0 0)",
      "sidebar-ring": "#b1040e",
      "badge": "#e8f4f8",
      "badge-foreground": "#007c92"
    },
    "dark": {
      "background": "#25282b",
      "foreground": "#dad7cb",
      "card": "#25282b",
      "card-foreground": "#dad7cb",
      "popover": "#25282b",
      "popover-foreground": "#dad7cb",
      "primary": "#b1040e",
      "primary-foreground": "#dad7cb",
      "secondary": "oklch(0.269 0 0)",
      "secondary-foreground": "#dad7cb",
      "muted": "oklch(0.269 0 0)",
      "muted-foreground": "oklch(0.708 0 0)",
      "accent": "#53565a",
      "accent-foreground": "#dad7cb",
      "destructive": "oklch(0.704 0.191 22.216)",
      "border": "oklch(1 0 0 / 10%)",
      "input": "oklch(1 0 0 / 15%)",
      "ring": "#b1040e",
      "chart-1": "#4298b5",
      "chart-2": "#279989",
      "chart-3": "#fedd5c",
      "chart-4": "#765e99",
      "chart-5": "#e98300",
      "sidebar": "#53565a",
      "sidebar-foreground": "#dad7cb",
      "sidebar-primary": "#b1040e",
      "sidebar-primary-foreground": "#dad7cb",
      "sidebar-accent": "#63666a",
      "sidebar-accent-foreground": "#dad7cb",
      "sidebar-border": "oklch(1 0 0 / 10%)",
      "sidebar-ring": "#b1040e",
      "badge": "#4298b5",
      "badge-foreground": "#ffffff"
    }
  },
  "css": {
    "@layer base": {
      "*": {
        "scrollbar-width": "thin",
        "scrollbar-color": "oklch(1 0 0 / 15%) transparent"
      },
      "button, [role=\"button\"]": {
        "cursor": "pointer"
      }
    }
  },
  "type": "registry:theme"
}
